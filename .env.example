APP_ENV=development
DATABASE_URL=postgresql+psycopg://tei:tei@localhost:5432/tei

# Google Calendar OAuth (leave empty to keep automatic sync disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google-calendar/callback
GOOGLE_RETURN_URL=http://localhost:5173/
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_SYNC_POLL=1

# Invitación y recuperación: cola persistente cifrada, envío SMTP STARTTLS.
PUBLIC_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
MAIL_TOKEN_ENCRYPTION_KEY=
